# Origin of the organizer backend (no /api/v1 suffix). Server-only: never exposed to the browser.
BACKEND_URL=http://localhost:4000

# Google "Web application" client ID for Sign in with Google. It is public (the
# browser needs it) and must be the same client Supabase's Google provider trusts.
# Add your app's origins (e.g. http://localhost:3000) under "Authorized JavaScript
# origins" in Google Cloud. Leave empty and the Google button stays disabled.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
